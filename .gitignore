# 示例原始仓库目录：2026-09-22 事故教训——数据必须纳入版本管理。
# 原 219MB 数据已随事故丢失，当前为重建后的源树（体积小，全部入库）。
# 新增大体量素材时请评估后再加忽略规则。

# JSON 示例物化缓存（可随时由 JSON 重建，非源码）
.json_examples_cache/

# 数据迁移备份（契约 §6.2：集合根下 .backup/<ts>/ 保留本地回滚能力，不入库）
json_examples/.backup/

# sidecar 日志（开发态 DATA_DIR = 仓库根；打包态走 userData）
logs/

# 编辑历史快照（开发态 DATA_DIR = 仓库根；打包态走 userData）
edit_history/

# 共享运行环境：所有示例统一使用仓库根 .venv（由 venv_manager 自动创建）
.venv/

# 旧版按示例隔离的 venv 缓存（已废弃，仅作防御性忽略）
.desktop-app-venvs/

# Python 字节码 / 缓存
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 本地测试产物（覆盖率二进制，每次跑测试都会重写）
.coverage

# AI 会话/工具产物（会话记忆与计划文档，不入库）
.workbuddy/
.workbuddy-ai/

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store

# 打包产物（electron-builder + PyInstaller sidecar）
electron-prototype/electron/dist/
electron-prototype/electron/sidecar-dist/
# PyInstaller 中间产物（Analysis/work；sidecar 冻结的增量缓存）
electron-prototype/electron/build-pyinstaller/work/

# TypeScript 增量构建缓存
*.tsbuildinfo

# Node / 构建产物
node_modules/
out/

# electron-vite 转译配置时落盘的临时文件（每次 build 都会生成）
electron-prototype/electron/electron.vite.config.*.mjs

# 应用运行时产物（userData 镜像）
user_examples/

# 工具运行产物（2026-09-23 审查后新增：工具默认在仓库根落盘，一律不入库）
/*.xlsx
/*.docx
/*.pptx
/*.pdf
/*.eml
/*.zip
/*.db
/*.csv
/*.bin
/*.log*
/TODO.md
/crawl_*
/download_demo*
/images/
/resized/
/cropped/
/watermarked/
/enhanced/
/styled/
/compressed/
/shot_*.png
/frame_*.png
/contact_sheet.jpg
/page.png

# 科研绘图大体积源数据（源在 ~/Downloads/Code_Notebook，gen_sciviz 可随时重转换）
examples_assets/code_notebook/chapter2/data/
examples_assets/code_notebook/chapter3/Data/
examples_assets/code_notebook/chapter4/Data/
.superpowers/

# 交互工具在仓库根手工运行时的播种产物（应用内运行落盘在 sidecar 工作区，不进仓库）
/contact_sheet.png
/sample_video.mp4
/sample_audio.wav
/示例图片/
/演示数据/
