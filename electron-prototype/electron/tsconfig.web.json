{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noImplicitAny": false,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "resolveJsonModule": true
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.d.ts",
    "src/renderer/*.ts",
    "src/renderer/*.d.ts",
    "src/renderer/**/*.vue",
    "src/renderer/components/__tests__/**/*.ts",
    "vitest.setup.ts",
    "../shared/**/*.ts",
    "../shared/**/*.json"
  ]
}
