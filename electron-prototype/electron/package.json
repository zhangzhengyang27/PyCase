{
  "name": "python-example-manager-electron",
  "version": "1.0.0",
  "description": "Electron 壳 + Python sidecar（vite + TypeScript + tailwindcss）",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron-vite dev",
    "smoke": "electron-vite build && SMOKE_TEST=1 electron .",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "sidecar": "python3 ../../scripts/build_sidecar.py --smoke",
    "dist:mac": "npm run sidecar && electron-vite build && electron-builder --mac",
    "dist:win": "npm run sidecar && electron-vite build && electron-builder --win",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "format": "prettier --write \"**/*.{ts,tsx,vue,mjs,js,json,css,yml,yaml,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,vue,mjs,js,json,css,yml,yaml,html}\""
  },
  "build": {
    "appId": "com.example.python-example-manager",
    "productName": "Python示例管理器",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "../../requirements.txt",
        "to": "requirements.txt"
      },
      {
        "from": "../../requirements.lock.txt",
        "to": "requirements.lock.txt"
      },
      {
        "from": "../../json_examples",
        "to": "json_examples"
      },
      {
        "from": "../../topics",
        "to": "topics"
      },
      {
        "from": "../../tools",
        "to": "tools"
      },
      {
        "from": "../../projects",
        "to": "projects"
      },
      {
        "from": "../../examples_assets",
        "to": "examples_assets"
      },
      {
        "from": "sidecar-dist/sidecar",
        "to": "sidecar/sidecar"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dir",
        "zip",
        "dmg"
      ],
      "identity": null,
      "extraResources": [
        {
          "from": "../../requirements.txt",
          "to": "requirements.txt"
        },
        {
          "from": "../../requirements.lock.txt",
          "to": "requirements.lock.txt"
        },
        {
          "from": "../../json_examples",
          "to": "json_examples"
        },
        {
          "from": "../../topics",
          "to": "topics"
        },
        {
          "from": "../../tools",
          "to": "tools"
        },
        {
          "from": "../../projects",
          "to": "projects"
        },
        {
          "from": "../../examples_assets",
          "to": "examples_assets"
        },
        {
          "from": "sidecar-dist/sidecar",
          "to": "sidecar/sidecar"
        }
      ],
      "artifactName": "PyCase-${version}-${arch}-mac.${ext}"
    },
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "dir",
        "nsis",
        "zip"
      ],
      "extraResources": [
        {
          "from": "../../requirements.txt",
          "to": "requirements.txt"
        },
        {
          "from": "../../requirements.lock.txt",
          "to": "requirements.lock.txt"
        },
        {
          "from": "../../json_examples",
          "to": "json_examples"
        },
        {
          "from": "../../topics",
          "to": "topics"
        },
        {
          "from": "../../tools",
          "to": "tools"
        },
        {
          "from": "../../projects",
          "to": "projects"
        },
        {
          "from": "../../examples_assets",
          "to": "examples_assets"
        },
        {
          "from": "sidecar-dist/sidecar.exe",
          "to": "sidecar/sidecar.exe"
        }
      ],
      "artifactName": "PyCase-${version}-${arch}-setup.${ext}",
      "executableName": "PyCase"
    },
    "dmg": {
      "artifactName": "PyCase-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "PyCase-${version}-${arch}-setup.${ext}",
      "shortcutName": "${productName}",
      "uninstallDisplayName": "${productName}",
      "createDesktopShortcut": "always"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "lucide-vue-next": "^0.544.0",
    "monaco-editor": "^0.56.0",
    "reka-ui": "^2.10.5",
    "vue": "^3.5.42"
  }
}
